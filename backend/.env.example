GROQ_API_KEY=your_groq_api_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile
GROQ_TRANSLATION_MODEL_ALT=
AUDIO_CHUNK_SECONDS=2400
STREAMING_CHUNK_SECONDS=75
INITIAL_SUBTITLE_BUFFER_SECONDS=180
TRANSCRIPTION_CONCURRENCY=3
TRANSLATION_CONCURRENCY=1
TRANSLATION_BATCH_SIZE=2
TRANSLATION_RETRIES=3
# Use the OTPM allowance shown for the selected Groq model and tier.
GROQ_OUTPUT_TOKENS_PER_MINUTE=1000
GROQ_TRANSLATION_MAX_TOKENS=400
# Leave blank to derive a safe request rate from the two values above.
GROQ_RPM_LIMIT=
PORT=5000
NODE_ENV=development
